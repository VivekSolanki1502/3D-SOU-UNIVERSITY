# SOU 3D Disha Environment Configuration
PROJECT_NAME="SOU 3D Disha"
VERSION="1.0.0"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Security & JWT
SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
BACKEND_CORS_ORIGINS=[]

# PostgreSQL (Production Target)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="replace-with-a-unique-database-password"
POSTGRES_DB="sou_disha_db"

# Local DB URL Override (Defaults to SQLite for instant local dev if PostgreSQL is not active)
DATABASE_URL="sqlite+aiosqlite:///./sou_disha.db"

# Redis Cache (Production Target)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_ENABLED=True

# Admin Default Seed Credentials
# Seed User Credentials
SEED_ADMIN_EMAIL="admin@silveroakuni.ac.in"
SEED_ADMIN_PASSWORD="replace-with-a-unique-admin-password"
SEED_ADMIN_NAME="Campus Super Admin"
SEED_FACULTY_EMAIL="faculty@silveroakuni.ac.in"
SEED_FACULTY_PASSWORD="replace-with-a-unique-faculty-password"
SEED_FACULTY_NAME="Dr. Meera Shah (Faculty)"
SEED_STUDENT_EMAIL="student@silveroakuni.ac.in"
SEED_STUDENT_PASSWORD="replace-with-a-unique-student-password"
SEED_STUDENT_NAME="Vivek Solanki (Student)"
